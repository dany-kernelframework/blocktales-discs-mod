{
	"schemaVersion": 1,
	"id": "discs",
	"version": "${version}",
	"name": "Block Tales Discs",
	"description": "Your favourite songs from the Block Tales OST in form of a... music disc?",
	"authors": [
		"lead:",
		"@kernelframework: mod developer",
		"contributors:",
		"@thegreatshaman: textures",
		"@z9xomer: textures",
		"special thanks:",
		"the blocktales team and their composers: for making this possible"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/block-tales-discs",
		"sources": "https://github.com/dany-kernelframework/blocktales-discs-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/discs/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.kf.Discs"
		],
		"client": [
			"com.kf.client.DiscsClient"
		]
	},
	"mixins": [
		"discs.mixins.json",
		{
			"config": "discs.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}